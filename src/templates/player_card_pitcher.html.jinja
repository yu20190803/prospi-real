<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<title>{{ player.name }} #{{ player.uniform_number }}</title>
<link rel="stylesheet" href="../../../src/templates/style.css">
</head>
<body>
<div class="player-card">

  {% include "_header.html.jinja" %}

  <div class="card-body">
    <div class="main-col">
      <div class="upper-row">
        {% include "_photo_col.html.jinja" %}
        <div class="stat-col">
          {% include "_stat_rows.html.jinja" %}
        </div>
      </div>

      <div class="pitch-section">
        {% for panel in pitch_panels %}
        <div class="pitch-panel">
          <div class="pitch-no">{{ panel.order }}</div>
          <svg class="pitch-svg" viewBox="0 0 {{ panel.width }} {{ panel.height }}">
            {% for e in panel.empty %}{% for r in e.rungs %}
            <polygon points="{{ r.points }}" fill="{{ r.color }}" />
            {% endfor %}{% endfor %}

            {% for p in panel.pitches %}
              {% for r in p.rungs %}
              <polygon points="{{ r.points }}" fill="{{ r.color }}" />
              {% endfor %}
              {# 四角の塗り＝球威、左の黒文字＝球威、右のカラー文字＝制球 #}
              <rect x="{{ p.box.x }}" y="{{ p.box.y }}" width="{{ p.box.w }}" height="{{ p.box.h }}"
                    rx="2" fill="{{ p.box.fill }}" />
              <text x="{{ p.box.power_x }}" y="{{ p.box.text_y }}" class="pitch-power">{{ p.box.power }}</text>
              <text x="{{ p.box.control_x }}" y="{{ p.box.text_y }}" class="pitch-control"
                    fill="{{ p.box.control_color }}">{{ p.box.control }}</text>
              <text x="{{ p.label.x }}" y="{{ p.label.y }}"
                    text-anchor="{{ p.label.anchor }}" class="pitch-label">{{ p.label.text }}</text>
            {% endfor %}
          </svg>
        </div>
        {% endfor %}
      </div>
    </div>

    {% include "_abilities.html.jinja" %}
  </div>

</div>
</body>
</html>
