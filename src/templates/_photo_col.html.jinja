{# 投手・野手共通の左カラム（★とOVR、その下に顔写真） #}
<div class="photo-col">
  <div class="rarity-row">
    {% if player.rarity.star %}<span class="star">&#9733;</span>{% endif %}
    <span class="overall">{{ player.rarity.overall }}</span>
  </div>
  <div class="photo-box">
    {% if player.photo %}
      <img src="{{ player.photo }}" alt="{{ player.name }}">
    {% else %}
      <svg viewBox="0 0 100 100" class="photo-placeholder">
        <circle cx="50" cy="34" r="21" />
        <path d="M10 100c0-25 18-40 40-40s40 15 40 40z" />
      </svg>
    {% endif %}
  </div>
</div>
